// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run TIC-80.exe",
			"type": "process",
			"command": "${workspaceFolder}\\tools\\tic80\\tic80.exe",
			"args": [
				"${file}",
				"--fs=${fileDirname}",
				"--skip"
			],
			"problemMatcher": []
		},
		{
			"label": "Run STS",
			"type": "process",
			"command": "${workspaceFolder}\\tools\\tic80\\tic80.exe",
			"args": [
				"${workspaceFolder}\\src\\sts.lua",
				"--fs=${workspaceFolder}\\src",
				"--skip"
			],
			"options": {
				"cwd": "${workspaceFolder}\\src"
			},
			"problemMatcher": []
		}
	]
}